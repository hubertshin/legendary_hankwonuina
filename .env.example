# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hankwon_uina?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OAuth Providers (optional - can use email magic link only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Email Provider (for magic link)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@1book1me.com"

# AWS S3 (or S3-compatible storage like Cloudflare R2, MinIO)
S3_REGION="ap-northeast-2"
S3_BUCKET="hankwon-uina-audio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="" # Optional: for S3-compatible services

# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# OpenAI
OPENAI_API_KEY=""

# Stripe (optional - for payment)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# App Config
MAX_AUDIO_SIZE_MB="200"
MAX_CLIPS_PER_PROJECT="3"
FREE_PREVIEW_PAGES="2"

# Meta Pixel (Facebook Pixel)
NEXT_PUBLIC_META_PIXEL_ID=""

# Admin Access (comma-separated list of admin emails)
ADMIN_EMAILS="admin@example.com"

# ==========================================
# 운영자 알림 (신청 접수 시 메일)
# ==========================================
# 알림 받을 주소. 쉼표로 여러 명 지정 가능.
ADMIN_NOTIFY_EMAIL="onebookobeme@gmail.com"

# Gmail SMTP를 쓰려면 앱 비밀번호가 필요합니다 (일반 비밀번호로는 로그인 불가).
#   1. Google 계정 → 보안 → 2단계 인증 사용 설정
#   2. https://myaccount.google.com/apppasswords 에서 앱 비밀번호 생성
#   3. 생성된 16자리를 EMAIL_SERVER_PASSWORD 에 입력
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="onebookobeme@gmail.com"
# EMAIL_SERVER_PASSWORD="앱-비밀번호-16자리"
# EMAIL_FROM="한권의나 <onebookobeme@gmail.com>"

# Resend (권장) — Gmail 앱 비밀번호 발급이 막힐 때의 대안
# https://resend.com 가입 후 API Keys → Create
# 받는 사람이 가입 계정과 같으면 도메인 인증 없이 바로 발송됩니다.
RESEND_API_KEY=""
# 도메인 인증 전에는 onboarding@resend.dev 만 사용 가능합니다.
# RESEND_FROM="한권의나 <noreply@1book1me.com>"
